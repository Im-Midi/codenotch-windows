{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Codenotch",
  "version": "0.4.0",
  "identifier": "com.immidi.codenotch",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "notch",
        "url": "notch.html",
        "width": 18,
        "height": 132,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": false,
        "visible": false,
        "focus": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "penyu101",
    "copyright": "Created by penyu101 · based on Codenotch (MIT)",
    "icon": ["icons/icon.ico"],
    "resources": {
      "../target/release/codenotch-hook.exe": "codenotch-hook.exe"
    },
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" }
    }
  }
}
